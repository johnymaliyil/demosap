{
  "name": "physicalinventory",
  "version": "1.0.0",
  "private": true,
  "description": "SAP EWM Physical Inventory demo — Fiori Elements app deployed to the ABAP UI5 repository",
  "scripts": {
    "start": "ui5 serve --config=ui5.yaml --open index.html",
    "start-noflp": "ui5 serve --config=ui5.yaml --open index.html",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "deploy": "fiori deploy --config ui5-deploy.yaml",
    "undeploy": "fiori undeploy --config ui5-deploy.yaml"
  },
  "devDependencies": {
    "@ui5/cli": "^4",
    "@sap/ux-ui5-tooling": "^1"
  }
}
