{
  "_version": "1.65.0",
  "sap.app": {
    "id": "physicalinventory",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.0.0",
      "toolsId": "physicalinventory"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/api_whse_physinvtryitem_2/srvd_a2x/sap/whsephysicalinventorydoc/0001/",
        "type": "OData",
        "settings": {
          "annotations": ["annotation"],
          "odataVersion": "4.0"
        }
      },
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://inventory",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ushell": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "physicalinventory.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "WhsePhysicalInventoryItemList",
          "target": "WhsePhysicalInventoryItemList"
        },
        {
          "pattern": "WhsePhysicalInventoryItem({key}):?query:",
          "name": "WhsePhysicalInventoryItemObjectPage",
          "target": "WhsePhysicalInventoryItemObjectPage"
        }
      ],
      "targets": {
        "WhsePhysicalInventoryItemList": {
          "type": "Component",
          "id": "WhsePhysicalInventoryItemList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "WhsePhysicalInventoryItem",
              "variantManagement": "Page",
              "navigation": {
                "WhsePhysicalInventoryItem": {
                  "detail": {
                    "route": "WhsePhysicalInventoryItemObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "WhsePhysicalInventoryItemObjectPage": {
          "type": "Component",
          "id": "WhsePhysicalInventoryItemObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "WhsePhysicalInventoryItem",
              "editableHeaderContent": false
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
