<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local UI annotations for the Fiori Elements List Report / Object Page.

  Confirmed against the real $metadata from https://dw4.sap.solar.eu:44300
  (namespace, entity types, entity sets, and field names all verified —
  this is no longer a placeholder).

  Entity structure: WhsePhysicalInventoryItem (list report rows) has a
  composition child WhsePhysicalInventoryCountItem (the actual count
  detail per storage bin/product/batch), reached via navigation property
  _WhsePhysicalInventoryCntItem. There is no separate "document header"
  entity, and no book-quantity field — this API only exposes the entered
  count quantity (RequestedQuantity), not a book-vs-counted comparison.
-->
<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
